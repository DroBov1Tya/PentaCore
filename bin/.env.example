# Copy to `.env` in the same directory as the pentacore executable.
# A `.env` in the working directory is ignored on purpose.
# Every variable is optional; with none set the server runs MCP over stdio only.

# Log filter (tracing syntax). Logs go to stderr.
# Default: warn,pentacore=info
#RUST_LOG=warn,pentacore=debug

# Data directory: brain.sqlite and models/.
# Absolute, `~/...` for the user's home, or relative to the executable's directory.
# Default: ~/.pentacore
#PENTACORE_HOME=

# Tools listed to the agent: `core` (the everyday ones) or `full`. Default: core
#PENTACORE_TOOLS=core

# Project used when a tool call does not name one. Default: name of the working directory.
#PENTACORE_PROJECT=

# The HTTP API is off unless both variables are set. Loopback addresses only.
# Clients must connect to this literal address; `localhost` is refused.
#PENTACORE_HTTP_ADDR=127.0.0.1:8082
# At least 32 characters, e.g. `openssl rand -hex 32`.
#PENTACORE_HTTP_TOKEN=
